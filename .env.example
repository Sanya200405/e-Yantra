# ==============================================================================
# Yantrahub - Production Cloud Environment Configuration
# Target Domain: https://yantrahub.vercel.app
# ==============================================================================

# Database Configuration
# Cloud PostgreSQL (Supabase / Neon / Railway / Vercel Postgres):
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# Local SQLite (for local development fallback):
# DATABASE_URL="file:./dev.db"

# Application URL & Auth Secrets
NEXT_PUBLIC_APP_URL="https://yantrahub.vercel.app"
NEXTAUTH_URL="https://yantrahub.vercel.app"
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret-key"

# Official e-Yantra Portal URL
NEXT_PUBLIC_EYANTRA_PORTAL_URL="https://portal.e-yantra.org"

# GitHub API Integration (Optional - for higher rate limits and private repo access)
GITHUB_API_TOKEN=""
